# BranchMe GitHub token template.
# Copy this file to .env only when you need pull_request support or PR field autofill.
# Keep committed token placeholders empty; put real tokens only in your local .env file.
GITHUB_TOKEN=
GH_TOKEN=

# Optional: allow pull_request to fill omitted branches, title, body, and draft.
# Explicit values always win. Disabled by default.
BRANCHME_PR_AUTOFILL=false
